# config/secrets.yaml
# Copy to secrets.yaml and fill in credentials. Git-ignored.
# WiFi credentials live in config/wifi.yaml (separate file, not encrypted).
# Encrypt with: age --passphrase -o config/secrets.yaml.age config/secrets.yaml

system:
  root_password:
  user_password:

features:
  # SSH keys live in config/base_ssh.yaml and config/{profile}_ssh.yaml[.age]

  pia:
    config:
      username:
      password:

postconfig:
  gnome:
    keybindings:
      enabled: true
      bindings:
        - name: Password
          command: ""
          binding: "<Control><Alt>p"
