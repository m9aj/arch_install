alias ls='ls --color'
alias cl='clear'
alias pas='sudo pacman -S'
alias par='sudo pacman -Rns'
alias pau='sudo pacman -Syu; sudo paccache -rk1'
alias Makepkg='makepkg -sic --skippgpcheck'
alias yas='paru -S --noconfirm'
alias yau='paru -Syu'
alias czs='chezmoi status'
alias czd='chezmoi diff'
alias cza='chezmoi apply'
alias czad='chezmoi add'
alias cze='chezmoi edit'
alias czcd='chezmoi cd'
alias czra='chezmoi re-add'
alias giti='git init .'
alias gits='git status'
alias gita='git add'
alias gitaa='git add .'
alias gitc='git commit -m'
alias gitra='git remote add origin'
alias gitp='git push origin $(git branch --show-current)'
alias uefi='sudo systemctl reboot --firmware-setup'
alias ref='sudo systemctl start reflector.service'
alias shortcuts='grep "^alias" ~/.zshrc | sed "s/alias //"'
alias agyd='agy --dangerously-skip-permissions'
alias gem='gemini'

# Modern CLI tools & aliases
if (( $+commands[eza] )); then
    alias ls='eza --icons'
    alias l='eza -lh --icons'
    alias la='eza -lha --icons'
    alias ll='eza -lh --icons --git'
    alias lt='eza --tree --level=2 --icons'
fi

if (( $+commands[bat] )); then
    alias cat='bat --paging=never'
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

if (( $+commands[duf] )); then
    alias df='duf'
fi

if (( $+commands[dust] )); then
    alias du='dust'
fi

# Launch GUI apps decoupled from special workspace / terminal
if (( $+commands[launch] )); then
    alias zen='launch zen-browser'
    alias nautilus='launch nautilus'
fi

# Shell integrations
if (( $+commands[fnm] )); then
    eval "$(fnm env --use-on-cd)"
fi
if (( $+commands[fzf] )); then
    eval "$(fzf --zsh)"
fi
if (( $+commands[zoxide] )); then
    eval "$(zoxide init --cmd cd zsh)"
fi

# yazi cwd wrapper
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# Impasto Animated Fastfetch Greeting
function fa() {
    local dir="${XDG_STATE_HOME:-$HOME/.local/state}/quickshell" choice=""
    if [[ -n "$1" && "$1" != -* ]]; then
        if [[ ! -f "$dir/greeting-$1.gif" ]]; then
            print -u2 "fa: no scene called $1 — lava, critters, koi, invaders"
            return 1
        fi
        fastfetch --logo "$dir/greeting-$1.gif"
        return
    fi
    [[ -r "$dir/greeting" ]] && choice="$(<"$dir/greeting")"
    local scenes=("$dir"/greeting-*.gif(N))
    if [[ "$choice" == random ]] && (( $#scenes )); then
        fastfetch --logo "${scenes[RANDOM % $#scenes + 1]}" "$@"
    else
        fastfetch "$@"
    fi
}

# Impasto Palette-synced terminal toys
alias matrix="unimatrix -c cyan -s 96 -l m"
alias bonsai="cbonsai -l -k 6,3,14,11"
alias clock="tty-clock -c -s -n -C 6"

lava() {
  local -A slot
  local name value
  kitten @ get-colors 2>/dev/null | while read -r name value; do slot[$name]=${value#\#}; done
  if [[ -n ${slot[color6]} && -n ${slot[color14]} ]]; then
    lavat -g -G -c "${slot[color6]}" -k "${slot[color14]}" "$@"
  else
    lavat -G -c cyan "$@"
  fi
}

# Local overrides
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
