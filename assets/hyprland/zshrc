# Set the directory we want to store zinit and plugins
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname "$ZINIT_HOME")"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Add in zsh plugins
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zinit light zsh-users/zsh-autosuggestions
zinit light Aloxaf/fzf-tab

# Add in snippets
zinit snippet OMZP::sudo #(Press Esc twice to add sudo)

# Load completions
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi
zinit cdreplay -q

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --icons "$realpath"'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza -1 --color=always --icons "$realpath"'

# Custom Prompt
if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
fi

# History
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_reduce_blanks

# Keybindings
bindkey "^[[3~" delete-char		# Del
bindkey "^[[2~" quoted-insert		# Ins
bindkey "^[[H" beginning-of-line	# Home
bindkey "^[[F" end-of-line		# End
bindkey "^[[5~" beginning-of-history	# PageUp
bindkey "^[[6~" end-of-history		# PageDown

# Environment Variables & Paths
typeset -U path PATH
for matlab_bin in /usr/local/MATLAB/*/bin(N); do
    export PATH="$matlab_bin:$PATH"
done
unset matlab_bin
export PATH="$HOME/.local/bin:$HOME/.local/share/omarchy/bin:$HOME/Projects/Scripts:${PATH}"
export EDITOR='micro'
export VISUAL='gnome-text-editor'

