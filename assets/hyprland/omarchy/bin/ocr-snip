#!/bin/bash
# Native Screen OCR Tool using grim, slurp, and tesseract
SELECTION=$(slurp 2>/dev/null)
[[ -z "$SELECTION" ]] && exit 0

TEXT=$(grim -g "$SELECTION" - 2>/dev/null | tesseract - - -l eng 2>/dev/null)
TEXT="$(echo -e "${TEXT}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

if [[ -n "$TEXT" ]]; then
  printf '%s' "$TEXT" | wl-copy
  PREVIEW="${TEXT:0:60}"
  ((${#TEXT} > 60)) && PREVIEW="${PREVIEW:0:57}..."
  notify-send "OCR Text Copied" "$PREVIEW"
else
  notify-send -u low "OCR Failed" "No readable text detected in selected region"
fi
