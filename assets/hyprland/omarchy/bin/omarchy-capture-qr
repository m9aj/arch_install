#!/bin/bash

# omarchy:summary=Decode a QR code from a screenshot region
# omarchy:group=capture
# omarchy:examples=omarchy capture qr

TMP_IMG="${XDG_RUNTIME_DIR:-/tmp}/omarchy-qr-$$.png"
TMP_PROC="${XDG_RUNTIME_DIR:-/tmp}/omarchy-qr-proc-$$.png"

cleanup() {
  [[ -n $PID ]] && kill $PID 2>/dev/null
  rm -f "$TMP_IMG" "$TMP_PROC"
}
trap cleanup EXIT

hyprpicker -r -z >/dev/null 2>&1 &
PID=$!
sleep .1
SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

grim -g "$SELECTION" "$TMP_IMG" 2>/dev/null || exit 1

decode_qr() {
  local img="$1"
  local res=""

  # Pass 1: ZXingReader direct (handles normal, inverted, rotated, MicroQR, styled web codes)
  if command -v ZXingReader >/dev/null 2>&1; then
    res=$(ZXingReader -single -bytes "$img" 2>/dev/null)
    if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
  fi

  # Pass 2: zbarimg direct (handles clipped borders and standard codes)
  if command -v zbarimg >/dev/null 2>&1; then
    res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$img" 2>/dev/null)
    if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
  fi

  # If basic passes failed, run ImageMagick preprocessing fallbacks
  if command -v magick >/dev/null 2>&1; then
    # Pass 3: Invert colors (dark mode / inverted web QR codes)
    if magick "$img" -negate "$TMP_PROC" 2>/dev/null; then
      if command -v zbarimg >/dev/null 2>&1; then
        res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
      if command -v ZXingReader >/dev/null 2>&1; then
        res=$(ZXingReader -single -bytes "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
    fi

    # Pass 4: Grayscale + normalized contrast + quiet zone border
    # (recovers tight selections where user cropped off the white margin)
    if magick "$img" -colorspace Gray -normalize -bordercolor white -border 20 "$TMP_PROC" 2>/dev/null; then
      if command -v ZXingReader >/dev/null 2>&1; then
        res=$(ZXingReader -single -bytes "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
      if command -v zbarimg >/dev/null 2>&1; then
        res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
    fi

    # Pass 5: Otsu auto-threshold binarization (fixes colored/gradient/low-contrast web QR codes)
    if magick "$img" -colorspace Gray -auto-threshold otsu -bordercolor white -border 20 "$TMP_PROC" 2>/dev/null; then
      if command -v ZXingReader >/dev/null 2>&1; then
        res=$(ZXingReader -single -bytes "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
      if command -v zbarimg >/dev/null 2>&1; then
        res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
    fi

    # Pass 6: 2x Upscaling (for small or low-res web thumbnail QR codes)
    if magick "$img" -resize 200% -bordercolor white -border 15 "$TMP_PROC" 2>/dev/null; then
      if command -v ZXingReader >/dev/null 2>&1; then
        res=$(ZXingReader -single -bytes "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
      if command -v zbarimg >/dev/null 2>&1; then
        res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
    fi
  fi

  return 1
}

RESULT=$(decode_qr "$TMP_IMG")

if [[ -z $RESULT ]]; then
  omarchy-notification-send -g 󰐲 -u critical "No QR code found" "Select a region containing a QR code"
  exit 1
fi

# Copy result to clipboard
if [[ $RESULT == otpauth://* || $RESULT == WIFI:* ]]; then
  printf '%s' "$RESULT" | wl-copy --sensitive
  PREVIEW="${RESULT:0:40}..."
else
  printf '%s' "$RESULT" | wl-copy
  PREVIEW="$RESULT"
  ((${#PREVIEW} > 60)) && PREVIEW="${PREVIEW:0:57}..."
fi

# Print to stdout when running interactively in a terminal
if [[ -t 1 ]]; then
  printf '%s\n' "$RESULT"
fi

# Notify with preview, and make clickable to open if it is a web URL
if [[ $RESULT == http://* || $RESULT == https://* ]]; then
  omarchy-notification-send -g 󰐲 "QR code copied to clipboard" "$PREVIEW" --exec xdg-open "$RESULT"
else
  omarchy-notification-send -g 󰐲 "QR code copied to clipboard" "$PREVIEW"
fi
