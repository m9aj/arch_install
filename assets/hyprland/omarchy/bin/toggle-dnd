#!/bin/bash
# Toggle Do Not Disturb (Silence Notifications)
state=$(quickshell ipc -p "${QUICKSHELL_PATH:-$HOME/.local/share/omarchy/shell}" call notifications toggleDnd 2>/dev/null)
quickshell ipc -p "${QUICKSHELL_PATH:-$HOME/.local/share/omarchy/shell}" call shell refresh omarchy.indicators 2>/dev/null || true

if [[ "$state" == "on" ]]; then
  notify-send -t 2000 "Notifications" "Do Not Disturb: ON"
else
  notify-send -t 2000 "Notifications" "Do Not Disturb: OFF"
fi
