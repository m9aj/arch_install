#!/bin/bash
# Open URL in a visible browser window on the regular desktop workspace
URL="${1:-https://wiki.hyprland.org/}"

if command -v firefox >/dev/null 2>&1; then
  exec launch firefox --new-window "$URL"
elif command -v google-chrome-stable >/dev/null 2>&1; then
  exec launch google-chrome-stable --new-window "$URL"
elif command -v chromium >/dev/null 2>&1; then
  exec launch chromium --new-window "$URL"
else
  exec launch xdg-open "$URL"
fi
