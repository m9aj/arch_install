#!/bin/bash
# Open URL in browser on active workspace and ensure it surfaces immediately
URL="${1:-https://wiki.hyprland.org/}"

if command -v zen-browser >/dev/null 2>&1; then
  browser_cmd="zen-browser --new-window \"$URL\""
elif command -v firefox >/dev/null 2>&1; then
  browser_cmd="firefox --new-window \"$URL\""
elif command -v google-chrome-stable >/dev/null 2>&1; then
  browser_cmd="google-chrome-stable --new-window \"$URL\""
elif command -v chromium >/dev/null 2>&1; then
  browser_cmd="chromium --new-window \"$URL\""
else
  browser_cmd="xdg-open \"$URL\""
fi

if command -v launch >/dev/null 2>&1; then
  launch $browser_cmd
else
  setsid bash -c "$browser_cmd" >/dev/null 2>&1 &
fi
