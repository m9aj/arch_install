#!/bin/bash
# Open config file in an editor on the regular desktop workspace
TARGET="${1:-$HOME/.config/hypr/hyprland.lua}"

if command -v gnome-text-editor >/dev/null 2>&1; then
  exec launch gnome-text-editor --new-window "$TARGET"
elif [[ -n "$EDITOR" ]] && command -v "$EDITOR" >/dev/null 2>&1; then
  exec launch ghostty -e "$EDITOR" "$TARGET"
elif command -v nano >/dev/null 2>&1; then
  exec launch ghostty -e nano "$TARGET"
else
  exec launch xdg-open "$TARGET"
fi
