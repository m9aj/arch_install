#!/bin/bash
# Native Robust QR Code Scanner
TMP_IMG="${XDG_RUNTIME_DIR:-/tmp}/qr-scan-$$.png"
TMP_PROC="${XDG_RUNTIME_DIR:-/tmp}/qr-proc-$$.png"

cleanup() {
  [[ -n $PID ]] && kill $PID 2>/dev/null
  rm -f "$TMP_IMG" "$TMP_PROC"
}
trap cleanup EXIT

hyprpicker -r -z >/dev/null 2>&1 &
PID=$!

SELECTION=$(slurp 2>/dev/null)
[[ -z $SELECTION ]] && exit 0

grim -g "$SELECTION" "$TMP_IMG" 2>/dev/null || exit 1

decode_qr() {
  local img="$1"
  local res=""

  # Pass 1: ZXingReader direct
  if command -v ZXingReader >/dev/null 2>&1; then
    res=$(ZXingReader -single -bytes "$img" 2>/dev/null)
    if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
  fi

  # Pass 2: zbarimg direct
  if command -v zbarimg >/dev/null 2>&1; then
    res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$img" 2>/dev/null)
    if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
  fi

  # Fallback passes with ImageMagick
  if command -v magick >/dev/null 2>&1; then
    # Pass 3: Invert colors (dark mode QR codes)
    if magick "$img" -negate "$TMP_PROC" 2>/dev/null; then
      if command -v zbarimg >/dev/null 2>&1; then
        res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
      if command -v ZXingReader >/dev/null 2>&1; then
        res=$(ZXingReader -single -bytes "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
    fi

    # Pass 4: Grayscale + normalized contrast + quiet zone border
    if magick "$img" -colorspace Gray -normalize -bordercolor white -border 20 "$TMP_PROC" 2>/dev/null; then
      if command -v ZXingReader >/dev/null 2>&1; then
        res=$(ZXingReader -single -bytes "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
      if command -v zbarimg >/dev/null 2>&1; then
        res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
    fi

    # Pass 5: Otsu auto-threshold binarization
    if magick "$img" -colorspace Gray -auto-threshold otsu -bordercolor white -border 20 "$TMP_PROC" 2>/dev/null; then
      if command -v ZXingReader >/dev/null 2>&1; then
        res=$(ZXingReader -single -bytes "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
      if command -v zbarimg >/dev/null 2>&1; then
        res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
    fi

    # Pass 6: 2x Upscaling
    if magick "$img" -resize 200% -bordercolor white -border 15 "$TMP_PROC" 2>/dev/null; then
      if command -v ZXingReader >/dev/null 2>&1; then
        res=$(ZXingReader -single -bytes "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
      if command -v zbarimg >/dev/null 2>&1; then
        res=$(zbarimg -q --raw -Sdisable -Sqrcode.enable "$TMP_PROC" 2>/dev/null)
        if [[ -n $res ]]; then printf '%s' "$res"; return 0; fi
      fi
    fi
  fi

  return 1
}

RESULT=$(decode_qr "$TMP_IMG")

if [[ -z $RESULT ]]; then
  notify-send -u critical "No QR Code Found" "Select a region containing a QR code"
  exit 1
fi

if [[ $RESULT == otpauth://* || $RESULT == WIFI:* ]]; then
  printf '%s' "$RESULT" | wl-copy --sensitive
  PREVIEW="${RESULT:0:40}..."
else
  printf '%s' "$RESULT" | wl-copy
  PREVIEW="$RESULT"
  ((${#PREVIEW} > 60)) && PREVIEW="${PREVIEW:0:57}..."
fi

[[ -t 1 ]] && printf '%s\n' "$RESULT"
notify-send "QR Code Copied" "$PREVIEW"
