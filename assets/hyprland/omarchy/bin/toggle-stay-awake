#!/bin/bash
# Toggle Stay Awake / Prevent Screen Sleep
STATE_DIR="$HOME/.local/state/omarchy/indicators"
STATE_FILE="$STATE_DIR/stay-awake"
mkdir -p "$STATE_DIR"

if [[ -f "$STATE_FILE" ]]; then
  rm -f "$STATE_FILE"
  notify-send -t 2000 "Stay Awake" "Disabled (Normal idle and sleep allowed)"
else
  touch "$STATE_FILE"
  notify-send -t 2000 "Stay Awake" "Enabled (System will stay awake)"
fi
