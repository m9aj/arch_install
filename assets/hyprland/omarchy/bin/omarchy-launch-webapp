#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

url="$1"
shift || true

browser=$(xdg-settings get default-web-browser 2>/dev/null)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1)

if [[ -n "$browser_exec" ]] && command -v "$browser_exec" >/dev/null 2>&1; then
  exec setsid uwsm-app -- "$browser_exec" --app="$url" "$@"
elif command -v chromium >/dev/null 2>&1; then
  exec setsid uwsm-app -- chromium --app="$url" "$@"
elif command -v google-chrome-stable >/dev/null 2>&1; then
  exec setsid uwsm-app -- google-chrome-stable --app="$url" "$@"
elif command -v omarchy-launch-browser >/dev/null 2>&1; then
  exec omarchy-launch-browser "$url" "$@"
else
  exec xdg-open "$url"
fi
